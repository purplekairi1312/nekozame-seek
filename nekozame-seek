#!/usr/bin/env python3
"""nekozame-seek: Soulseek in the terminal, through slskd.

slskd stays logged in, shares and downloads all the time (on a server); this is where you
search and pick, over ssh or on your own machine. Close it and everything keeps going.

Results come as albums (one user's folder), the best first:
  1. lossless before lossy
  2. the highest bit depth, then the highest sample rate (24/192 before 24/96 before 16/44.1)
  3. the biggest in MB, counting only the audio files (not scans, booklets or a second
     copy in another format)
The best one is picked: Enter downloads the whole album.

  nekozame-seek                 the TUI
  nekozame-seek "search words"  the TUI, searching straight away

Settings: ~/.config/nekozame-seek/config.toml
  url = "http://localhost:5030"   slskd's address (on another machine: its Tailscale name)
  api_key = "..."                 slskd's API key (on the machine slskd runs on, it's read
                                  from ~/slskd/app/slskd.yml when this isn't set)
"""
import json
import os
import re
import sys
import time
import tomllib
import urllib.error
import urllib.request

AUDIO = {"flac": 3, "wav": 3, "aiff": 3, "aif": 3, "alac": 3, "ape": 3, "wv": 3, "dsf": 3, "dff": 3,
         "m4a": 1, "mp3": 1, "ogg": 1, "opus": 1, "aac": 1, "wma": 1}
LOSSLESS = {e for e, v in AUDIO.items() if v == 3}
CONFIG = os.path.expanduser("~/.config/nekozame-seek/config.toml")


# --- slskd ------------------------------------------------------------------------------

def settings():
    conf = {}
    try:
        with open(CONFIG, "rb") as f:
            conf = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        pass
    conf.setdefault("url", "http://localhost:5030")
    if not conf.get("api_key"):  # on slskd's own machine: its key, read where it's kept
        try:
            text = open(os.path.expanduser("~/slskd/app/slskd.yml")).read()
            m = re.search(r"nekozame_seek:\s*\n\s*key:\s*(\S+)", text)
            if m:
                conf["api_key"] = m.group(1)
        except OSError:
            pass
    return conf


class Slskd:
    def __init__(self, url, key):
        self.url, self.key = url.rstrip("/"), key or ""

    def call(self, method, path, body=None):
        req = urllib.request.Request(f"{self.url}/api/v0{path}", method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"X-API-Key": self.key, "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            data = r.read()
        return json.loads(data) if data else None

    def status(self):
        """who you're logged in as and what you share, or why not"""
        try:
            app = self.call("GET", "/application")
        except (OSError, ValueError) as e:
            return f"slskd isn't answering at {self.url} ({e})"
        server, user, shares = app.get("server", {}), app.get("user", {}), app.get("shares", {})
        if server.get("isLoggedIn"):
            return f"logged in as {user.get('username', '?')} · sharing {shares.get('files', 0):,} files"
        return f"not logged in to Soulseek ({server.get('state') or 'no login yet'}): on the server, ~/slskd/set-login"

    def search(self, text):
        return self.call("POST", "/searches", {"searchText": text})["id"]

    def search_state(self, sid):
        return self.call("GET", f"/searches/{sid}")

    def responses(self, sid):
        return self.call("GET", f"/searches/{sid}/responses") or []

    def download(self, username, files):
        self.call("POST", f"/transfers/downloads/{urllib.request.quote(username)}",
                  [{"filename": f["filename"], "size": f["size"]} for f in files])

    def downloads(self):
        return self.call("GET", "/transfers/downloads") or []


# --- albums: the results, grouped and ranked ---------------------------------------------

def folder(path):
    return re.split(r"[\\/]", path)[:-1]


def ext(f):
    return (f.get("extension") or os.path.splitext(f["filename"])[1]).lower().lstrip(".")


def albums(responses):
    """each user's folders with audio in them, as albums with their quality"""
    out = []
    for r in responses:
        by_folder = {}
        for f in r.get("files") or []:
            by_folder.setdefault(tuple(folder(f["filename"])), []).append(f)
        for path, files in by_folder.items():
            audio = [f for f in files if ext(f) in AUDIO]
            if not audio:
                continue
            lossless = [f for f in audio if ext(f) in LOSSLESS]
            main = lossless or audio  # the album's real format: its lossless files if it has them
            depth = max((f.get("bitDepth") or 0) for f in main)
            rate = max((f.get("sampleRate") or 0) for f in main)
            if lossless and not depth:  # not said: CD quality, the usual
                depth, rate = 16, rate or 44100
            out.append({
                "user": r["username"], "path": path, "files": files, "audio": main,
                "lossless": bool(lossless), "depth": depth, "rate": rate,
                "bitrate": max((f.get("bitRate") or 0) for f in main),
                "mb": sum(f["size"] for f in main) / 1e6,
                "format": "/".join(sorted({ext(f).upper() for f in main})),
                "free": r.get("hasFreeUploadSlot", False), "speed": r.get("uploadSpeed") or 0,
                "queue": r.get("queueLength") or 0,
            })
    return out


SORTS = {
    # the default: lossless, bit depth, sample rate, then the biggest; a free slot and speed break ties
    "quality": lambda a: (a["lossless"], a["depth"], a["rate"], a["bitrate"] if not a["lossless"] else 0,
                          a["mb"], a["free"], a["speed"]),
    "size": lambda a: (a["mb"], a["lossless"], a["depth"], a["rate"]),
    "speed": lambda a: (a["free"], a["speed"], -a["queue"]),
}


def quality(a):
    if a["lossless"]:
        return f"{a['depth']}/{a['rate'] / 1000:g}"
    return f"{a['bitrate']}k" if a["bitrate"] else "?"


def title(a):
    parts = [p for p in a["path"] if p]
    return " / ".join(parts[-2:]) if parts else "(top folder)"


# --- the TUI -----------------------------------------------------------------------------

HELP = """[b #ffc0e5]How it works[/]

  Type what you're looking for (artist and album) and press [b]Enter[/].

  Albums come in best first:
    [#ffd4ee]1.[/] lossless (FLAC, WAV…) before lossy (MP3…)
    [#ffd4ee]2.[/] the highest bit depth: 32, then 24, then 16
    [#ffd4ee]3.[/] the highest sample rate: 192 kHz, then 96, then 48, then 44.1
    [#ffd4ee]4.[/] the biggest, counting only the music

  [b #ffc0e5]★[/] marks the best one, already picked: [b]Enter[/] downloads the whole album.
  [b]↑ ↓[/] to pick another.

  [#b3a7cb]b / s / f  best first / biggest / fastest      d  downloads
  /  search again                                q  quit[/]
"""


def tui(first_search=None):
    os.environ.setdefault("COLORTERM", "truecolor")  # over ssh it isn't said, and it's all grey without
    from textual.app import App
    from textual.binding import Binding
    from textual.containers import Vertical
    from textual.widgets import DataTable, Footer, Input, Static, TabbedContent, TabPane

    conf = settings()
    api = Slskd(conf["url"], conf.get("api_key"))

    class Seek(App):
        TITLE = "nekozame-seek"
        ENABLE_COMMAND_PALETTE = False
        CSS = """
        Screen { background: #5a4f6e; color: #ffffff; }
        #top { height: 1; padding: 0 1; background: #433a55; }
        #title { width: auto; color: #ffc0e5; text-style: bold; }
        #status { width: 1fr; color: #e8def5; text-align: right; }
        TabbedContent { height: 1fr; }
        Tabs { background: #4f4562; }
        Tab { color: #e8def5; }
        Tab.-active { color: #ffc0e5; text-style: bold; }
        Underline > .underline--bar { color: #ffc0e5; background: #685c7f; }
        Input { background: #433a55; border: round #8a76a8; color: #ffffff; margin: 1 1 0 1; }
        Input:focus { border: round #ffc0e5; }
        Input > .input--placeholder { color: #b3a7cb; }
        #help { padding: 1 3; color: #ffffff; }
        #summary { height: 1; padding: 0 2; color: #ffd4ee; }
        DataTable { background: #4f4562; height: 1fr; margin: 0 1; scrollbar-color: #8a76a8; scrollbar-background: #433a55; }
        DataTable > .datatable--header { background: #433a55; color: #ffc0e5; text-style: bold; }
        DataTable > .datatable--cursor { background: #ffc0e5; color: #433a55; text-style: bold; }
        DataTable > .datatable--hover { background: #685c7f; }
        Footer { background: #433a55; color: #e8def5; }
        FooterKey { background: #433a55; }
        FooterKey .footer-key--key { background: #433a55; color: #ffc0e5; text-style: bold; }
        FooterKey .footer-key--description { background: #433a55; color: #e8def5; }
        """
        BINDINGS = [
            Binding("b", "sort('quality')", "best first"),
            Binding("s", "sort('size')", "biggest"),
            Binding("f", "sort('speed')", "fastest"),
            Binding("slash", "focus_search", "new search"),
            Binding("d", "show_downloads", "downloads"),
            Binding("q", "quit", "quit"),
            Binding("ctrl+c", "quit", "quit", show=False),
        ]

        def compose(self):
            from textual.containers import Horizontal
            with Horizontal(id="top"):
                yield Static("🦈 nekozame-seek", id="title")
                yield Static("…", id="status")
            with TabbedContent(initial="search"):
                with TabPane("search", id="search"):
                    with Vertical():
                        yield Input(placeholder="search Soulseek: artist and album, then Enter", id="query")
                        yield Static("", id="summary")
                        yield Static(HELP, id="help")
                        yield DataTable(id="results", cursor_type="row")
                with TabPane("downloads", id="downloads"):
                    yield DataTable(id="transfers", cursor_type="row")
            yield Footer()

        def on_mount(self):
            self.sort, self.found, self.sid, self.searching = "quality", [], None, False
            res = self.query_one("#results", DataTable)
            res.add_columns("", "bits", "kHz", "format", "size", "tracks", "from", "can start", "album")
            res.display = False
            self.query_one("#transfers", DataTable).add_columns("album", "from", "tracks", "done", "state")
            self.set_interval(1.0, self.poll)
            self.set_interval(3.0, self.poll_downloads)
            self.set_interval(30.0, self.refresh_status)
            self.refresh_status()
            if first_search:
                self.query_one("#query", Input).value = first_search
                self.start(first_search)
            else:
                self.query_one("#query", Input).focus()

        def refresh_status(self):
            self.query_one("#status", Static).update(api.status())

        def start(self, text):
            try:
                self.sid, self.found, self.searching, self.text = api.search(text), [], True, text
            except (OSError, ValueError, KeyError) as e:
                self.query_one("#summary", Static).update(f"couldn't search: {e}")
                return
            self.query_one("#help", Static).display = False
            res = self.query_one("#results", DataTable)
            res.display = True
            self.show()
            res.focus()

        def on_input_submitted(self, event):
            if event.value.strip():
                self.start(event.value.strip())

        def on_data_table_row_selected(self, event):
            if event.data_table.id == "results":
                self.download(event.cursor_row)

        def poll(self):
            if not self.sid or not self.searching:
                return
            try:
                state = api.search_state(self.sid)
                self.found = albums(api.responses(self.sid))
            except (OSError, ValueError):
                return
            self.searching = not state.get("isComplete")
            self.show(keep_cursor=True)

        def show(self, keep_cursor=False):
            res = self.query_one("#results", DataTable)
            at = res.cursor_row if keep_cursor else 0
            self.found.sort(key=SORTS[self.sort], reverse=True)
            res.clear()
            for i, a in enumerate(self.found[:400]):
                bits = str(a["depth"]) if a["lossless"] else f"{a['bitrate']}k" if a["bitrate"] else "?"
                khz = f"{a['rate'] / 1000:g}" if a["rate"] else ""
                res.add_row("★" if i == 0 and self.sort == "quality" else "", bits, khz, a["format"],
                            f"{a['mb']:,.0f} MB", str(len(a["audio"])), a["user"][:18],
                            "now" if a["free"] else f"{a['queue']} in line", title(a), key=str(i))
            if self.found:
                res.move_cursor(row=min(at, len(self.found) - 1))
            how = {"quality": "best first", "size": "biggest first", "speed": "fastest first"}[self.sort]
            if self.searching:
                text = f"searching for “{self.text}”… {len(self.found)} albums so far, {how}"
            elif self.found:
                text = f"{len(self.found)} albums for “{self.text}”, {how} · Enter downloads the one picked"
            else:
                text = f"nothing found for “{self.text}”: try fewer words"
            self.query_one("#summary", Static).update(text)

        def action_sort(self, how):
            self.sort = how
            self.show()

        def action_focus_search(self):
            self.query_one(TabbedContent).active = "search"
            self.query_one("#query", Input).focus()

        def action_show_downloads(self):
            self.query_one(TabbedContent).active = "downloads"
            self.poll_downloads()

        def download(self, row):
            if not self.found:
                return
            a = self.found[row]
            try:
                api.download(a["user"], a["files"])  # the whole folder: the music, its cover, the log
            except (OSError, ValueError) as e:
                self.notify(f"couldn't queue it: {e}", severity="error")
                return
            self.notify(f"downloading {title(a)}: {a['mb']:,.0f} MB, {quality(a)} {a['format']}, from {a['user']} (d shows it)")

        def poll_downloads(self):
            if self.query_one(TabbedContent).active != "downloads":
                return
            try:
                users = api.downloads()
            except (OSError, ValueError):
                return
            t = self.query_one("#transfers", DataTable)
            t.clear()
            for u in users:
                for d in u.get("directories") or []:
                    files = d.get("files") or []
                    size = sum(f.get("size") or 0 for f in files) or 1
                    done = sum(f.get("bytesTransferred") or 0 for f in files)
                    states = {(f.get("state") or "").split(",")[-1].strip() for f in files}
                    state = "done" if states <= {"Succeeded"} else ", ".join(sorted(states)).lower()
                    t.add_row(" / ".join(folder(d["directory"] + "\\x")[-2:]), u["username"],
                              str(len(files)), f"{100 * done / size:.0f}%", state)

    Seek().run()


if __name__ == "__main__":
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        sys.exit(0)
    tui(" ".join(sys.argv[1:]) or None)
