#!/usr/bin/env python3
"""nekozame-seek: Soulseek in the terminal, through slskd.

slskd stays logged in, shares and downloads all the time (on a server); this is where you
search and pick, over ssh or on your own machine. Close it and everything keeps going.

Results come as albums (one user's folder), the best first:
  1. lossless before lossy
  2. the highest bit depth, then the highest sample rate (24/192 before 24/96 before 16/44.1)
  3. the biggest in MB, counting only the audio files (not scans, booklets or a second
     copy in another format)
The best one is picked: Enter downloads the whole album.

  nekozame-seek                 the TUI
  nekozame-seek "search words"  the TUI, searching straight away

Settings: ~/.config/nekozame-seek/config.toml
  url = "http://localhost:5030"   slskd's address
  downloads = "/mnt/Megalodon/Downloads/Soulseek"   where slskd puts them (the library tab)
  library = "/mnt/Megalodon/Music"                  where they go
  api_key = "..."                 slskd's API key (on the machine slskd runs on, it's read
                                  from ~/slskd/app/slskd.yml when this isn't set)
"""
import json
import os
import re
import sys
import time
import tomllib
import urllib.error
import urllib.request

AUDIO = {"flac": 3, "wav": 3, "aiff": 3, "aif": 3, "alac": 3, "ape": 3, "wv": 3, "dsf": 3, "dff": 3,
         "m4a": 1, "mp3": 1, "ogg": 1, "opus": 1, "aac": 1, "wma": 1}
LOSSLESS = {e for e, v in AUDIO.items() if v == 3}
CONFIG = os.path.expanduser("~/.config/nekozame-seek/config.toml")


# --- slskd ------------------------------------------------------------------------------

def settings():
    conf = {}
    try:
        with open(CONFIG, "rb") as f:
            conf = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        pass
    conf.setdefault("url", "http://localhost:5030")
    conf.setdefault("downloads", "/mnt/Megalodon/Downloads/Soulseek")
    conf.setdefault("library", "/mnt/Megalodon/Music")
    if not conf.get("api_key"):  # on slskd's own machine: its key, read where it's kept
        try:
            text = open(os.path.expanduser("~/slskd/app/slskd.yml")).read()
            m = re.search(r"nekozame_seek:\s*\n\s*key:\s*(\S+)", text)
            if m:
                conf["api_key"] = m.group(1)
        except OSError:
            pass
    return conf


class Slskd:
    def __init__(self, url, key):
        self.url, self.key = url.rstrip("/"), key or ""

    def call(self, method, path, body=None):
        req = urllib.request.Request(f"{self.url}/api/v0{path}", method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"X-API-Key": self.key, "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            data = r.read()
        return json.loads(data) if data else None

    def status(self):
        """who you're logged in as and what you share, or why not"""
        try:
            app = self.call("GET", "/application")
        except (OSError, ValueError) as e:
            return f"slskd isn't answering at {self.url} ({e})"
        server, user, shares = app.get("server", {}), app.get("user", {}), app.get("shares", {})
        if server.get("isLoggedIn"):
            return f"logged in as {user.get('username', '?')} · sharing {shares.get('files', 0):,} files"
        return f"not logged in to Soulseek ({server.get('state') or 'no login yet'}): on the server, ~/slskd/set-login"

    def search(self, text):
        return self.call("POST", "/searches", {"searchText": text})["id"]

    def searches(self):
        """the searches slskd keeps (from any machine), newest first"""
        return sorted(self.call("GET", "/searches") or [], key=lambda x: x.get("startedAt") or "", reverse=True)

    def search_state(self, sid):
        return self.call("GET", f"/searches/{sid}")

    def responses(self, sid):
        return self.call("GET", f"/searches/{sid}/responses") or []

    def download(self, username, files):
        self.call("POST", f"/transfers/downloads/{urllib.request.quote(username)}",
                  [{"filename": f["filename"], "size": f["size"]} for f in files])

    def downloads(self):
        return self.call("GET", "/transfers/downloads") or []


# --- albums: the results, grouped and ranked ---------------------------------------------

def local_time(stamp):
    """slskd's UTC time, in this machine's time"""
    from datetime import datetime
    try:
        return datetime.fromisoformat(stamp[:19]).replace(tzinfo=__import__("datetime").timezone.utc) \
            .astimezone().strftime("%Y-%m-%d %H:%M")
    except (TypeError, ValueError):
        return ""


def folder(path):
    return re.split(r"[\\/]", path)[:-1]


def ext(f):
    return (f.get("extension") or os.path.splitext(f["filename"])[1]).lower().lstrip(".")


def albums(responses):
    """each user's folders with audio in them, as albums with their quality"""
    out = []
    for r in responses:
        by_folder = {}
        for f in r.get("files") or []:
            by_folder.setdefault(tuple(folder(f["filename"])), []).append(f)
        for path, files in by_folder.items():
            audio = [f for f in files if ext(f) in AUDIO]
            if not audio:
                continue
            lossless = [f for f in audio if ext(f) in LOSSLESS]
            main = lossless or audio  # the album's real format: its lossless files if it has them
            depth = max((f.get("bitDepth") or 0) for f in main)
            rate = max((f.get("sampleRate") or 0) for f in main)
            if lossless and not depth:  # not said: CD quality, the usual
                depth, rate = 16, rate or 44100
            out.append({
                "user": r["username"], "path": path, "files": files, "audio": main,
                "lossless": bool(lossless), "depth": depth, "rate": rate,
                "bitrate": max((f.get("bitRate") or 0) for f in main),
                "mb": sum(f["size"] for f in main) / 1e6,
                "format": "/".join(sorted({ext(f).upper() for f in main}))
                          + (" mixed" if len({(f.get("bitDepth"), f.get("sampleRate")) for f in main}) > 1 else ""),
                "free": r.get("hasFreeUploadSlot", False), "speed": r.get("uploadSpeed") or 0,
                "queue": r.get("queueLength") or 0,
            })
    return out


def tracks(responses):
    """every music file on its own (for singles and single tracks), ranked like albums"""
    out = []
    for r in responses:
        for f in r.get("files") or []:
            e = ext(f)
            if e not in AUDIO:
                continue
            lossless = e in LOSSLESS
            depth, rate = f.get("bitDepth") or 0, f.get("sampleRate") or 0
            if lossless and not depth:
                depth, rate = 16, rate or 44100
            out.append({
                "user": r["username"], "path": folder(f["filename"]), "files": [f], "audio": [f],
                "name": re.split(r"[\\/]", f["filename"])[-1], "length": f.get("length") or 0,
                "lossless": lossless, "depth": depth, "rate": rate, "bitrate": f.get("bitRate") or 0,
                "mb": f["size"] / 1e6, "format": e.upper(),
                "free": r.get("hasFreeUploadSlot", False), "speed": r.get("uploadSpeed") or 0,
                "queue": r.get("queueLength") or 0,
            })
    return out


SORTS = {
    # the default: lossless, bit depth, sample rate, then the biggest; a free slot and speed break ties
    "quality": lambda a: (a["lossless"], a["depth"], a["rate"], a["bitrate"] if not a["lossless"] else 0,
                          a["mb"], a["free"], a["speed"]),
    "size": lambda a: (a["mb"], a["lossless"], a["depth"], a["rate"]),
    "speed": lambda a: (a["free"], a["speed"], -a["queue"]),
}


def quality(a):
    if a["lossless"]:
        return f"{a['depth']}/{a['rate'] / 1000:g}"
    return f"{a['bitrate']}k" if a["bitrate"] else "?"


def title(a):
    parts = [p for p in a["path"] if p]
    return " / ".join(parts[-2:]) if parts else "(top folder)"


# --- the library: finished downloads put where they belong ------------------------------
#
# the library's own way: a folder per artist in "Artist Albums", each album in it under the
# name it came with (tracks keep theirs too); soundtracks in "Soundtracks/Interactive Media"
# (games) or "Linear Media" (films, series, anime); single songs loose in the artist's folder.
# nothing moves without being shown first, nothing is ever overwritten, and every move is
# written down so it can be undone.

KINDS = {"artist": "Artist Albums", "game": "Soundtracks/Interactive Media",
         "film": "Soundtracks/Linear Media", "unsorted": "Unsorted Archives"}
KIND_NAMES = {"artist": "artist album", "game": "game soundtrack", "film": "film/series soundtrack",
              "unsorted": "unsorted"}
MOVES = os.path.expanduser("~/.local/state/nekozame-seek/moves.jsonl")
GAME = re.compile(r"(?i)\b(game|video ?game|vgm|ost.*(sega|nintendo|playstation|xbox|snes|nes|gba|psx|ps[1-5])|"
                  r"nintendo|sega|playstation|soundtrack for the game|chiptune)\b")
SOUNDTRACK = re.compile(r"(?i)\b(ost|o\.s\.t\.?|original (motion picture |video game |game )?soundtrack|soundtrack|score)\b")


def tags(path):
    """the first music file's tags: albumartist, artist, album, date, genre (what's there)"""
    try:
        import mutagen
    except ImportError:
        return {}
    for f in sorted(os.listdir(path)):
        if ext({"filename": f}) in AUDIO:
            try:
                m = mutagen.File(os.path.join(path, f), easy=True)
            except Exception:  # a broken file: the folder name has to do
                continue
            if m and m.tags:
                return {k: (m.tags.get(k) or [""])[0] for k in ("albumartist", "artist", "album", "date", "genre")}
    return {}


def plain(name):
    """an artist's name to compare: no case, accents, "the" or punctuation"""
    import unicodedata
    n = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower()
    n = re.sub(r"^the\s+", "", n)
    return re.sub(r"[^a-z0-9]", "", n)


def artist_folder(library, artist):
    """the artist's folder as it already is in the library (its spelling), or the name as it is"""
    import difflib
    root = os.path.join(library, KINDS["artist"])
    want = plain(artist)
    try:
        folders = [d for d in os.listdir(root) if os.path.isdir(os.path.join(root, d))]
    except OSError:
        folders = []
    for d in folders:
        if plain(d) == want:
            return d
    # a near spelling (Gorillaz / Gorrilaz): the library's, when it's the only one that close
    close = [d for d in folders if want and difflib.SequenceMatcher(None, plain(d), want).ratio() >= 0.85]
    if len(close) == 1:
        return close[0]
    return artist.replace("/", "-").strip() or "Unknown Artist"


def music_files(path):
    return [os.path.join(d, f) for d, _, fs in os.walk(path) for f in fs if ext({"filename": f}) in AUDIO]


def guess(library, path):
    """where a finished download goes: (kind, artist, destination), from its tags and name"""
    t = tags(path)
    name = os.path.basename(path)
    text = f"{name} {t.get('album', '')} {t.get('genre', '')}"
    artist = t.get("albumartist") or t.get("artist") or ""
    if not artist:  # "Artist - Album" folders
        m = re.match(r"^(?:\[[^\]]*\]\s*|\(\d{4}\)\s*|\d{4}\s*[-.]\s*)?(.+?)\s+-\s+.+", name)
        artist = m.group(1) if m else ""
    if SOUNDTRACK.search(text) or "soundtrack" in t.get("genre", "").lower():
        kind = "game" if GAME.search(text) else "film"
    elif not artist:
        kind = "unsorted"
    else:
        kind = "artist"
    return kind, artist, destination(library, kind, artist, path)


def destination(library, kind, artist, path):
    name = os.path.basename(path)
    single = len(music_files(path)) == 1 and not any(os.path.isdir(os.path.join(path, x)) for x in os.listdir(path))
    if kind == "artist":
        base = os.path.join(library, KINDS["artist"], artist_folder(library, artist))
        # one song on its own: loose in the artist's folder, like the library's other singles
        return os.path.join(base, os.path.basename(music_files(path)[0])) if single else os.path.join(base, name)
    return os.path.join(library, KINDS[kind], name)


def quality_of(path):
    """a folder's music: the best bit depth/sample rate and its MB, from the files' headers"""
    try:
        import mutagen
    except ImportError:
        return ""
    depth = rate = size = 0
    for f in music_files(path):
        size += os.path.getsize(f)
        try:
            info = mutagen.File(f).info
            depth = max(depth, getattr(info, "bits_per_sample", 0) or 0)
            rate = max(rate, getattr(info, "sample_rate", 0) or 0)
        except Exception:
            pass
    q = f"{depth}/{rate / 1000:g} " if depth else ""
    return f"{q}{size / 1e6:,.0f} MB"


def finished(downloads, api):
    """the download folders that are complete: every file of theirs that slskd fetched has
    finished, and none has changed in the last minute"""
    busy = set()
    try:
        for u in api.downloads():
            for d in u.get("directories") or []:
                if not all("Succeeded" in (f.get("state") or "") for f in d.get("files") or []):
                    busy.add(re.split(r"[\\/]", d["directory"])[-1])  # downloading, waiting, or failed
    except (OSError, ValueError):
        return []
    out = []
    for name in sorted(os.listdir(downloads)):
        path = os.path.join(downloads, name)
        if name.startswith(".") or not os.path.isdir(path) or name in busy or not music_files(path):
            continue
        if time.time() - max(os.path.getmtime(f) for f in music_files(path)) < 60:
            continue
        out.append(path)
    return out


def move(src, dest, replace=False):
    """src to dest, safely. the same disk: a rename (instant, can't half-happen). another disk:
    every file copied and checked byte for byte first. never over anything: an album that's
    there already is only replaced when asked, and then kept aside, not deleted.
    written down in MOVES, so it can be undone"""
    import hashlib
    import shutil
    single = os.path.splitext(dest)[1].lower().lstrip(".") in AUDIO
    real_src = music_files(src)[0] if single else src
    aside = None
    if os.path.lexists(dest):
        if not replace:
            raise FileExistsError(f"{dest} is there already")
        aside = os.path.join(os.path.dirname(dest), f".replaced-{time.strftime('%Y%m%d-%H%M%S')}-{os.path.basename(dest)}")
        os.rename(dest, aside)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    if os.stat(real_src).st_dev == os.stat(os.path.dirname(dest)).st_dev:
        os.rename(real_src, dest)
    else:
        def digest(p):
            h = hashlib.sha256()
            with open(p, "rb") as f:
                for block in iter(lambda: f.read(1 << 20), b""):
                    h.update(block)
            return h.hexdigest()
        part = dest + ".part"
        (shutil.copy2 if single else shutil.copytree)(real_src, part)
        pairs = [(real_src, part)] if single else [
            (os.path.join(d, f), os.path.join(part, os.path.relpath(os.path.join(d, f), real_src)))
            for d, _, fs in os.walk(real_src) for f in fs]
        for a, b in pairs:
            if digest(a) != digest(b):
                shutil.rmtree(part, ignore_errors=True) if not single else os.remove(part)
                raise OSError(f"the copy of {a} doesn't match: nothing moved")
        os.rename(part, dest)
        (os.remove if single else shutil.rmtree)(real_src)
    if single and os.path.isdir(src) and not music_files(src):
        shutil.rmtree(src)  # what came with the song (a cover, a log) goes with the download folder
    os.makedirs(os.path.dirname(MOVES), exist_ok=True)
    with open(MOVES, "a") as f:
        f.write(json.dumps({"when": time.strftime("%Y-%m-%d %H:%M:%S"), "from": real_src, "to": dest,
                            "aside": aside}) + "\n")


def undo_last():
    """the last move, back where it came from (and what it replaced, back in its place)"""
    try:
        lines = open(MOVES).read().splitlines()
    except OSError:
        return "nothing to undo"
    if not lines:
        return "nothing to undo"
    last = json.loads(lines[-1])
    if os.path.lexists(last["from"]):
        return f"can't undo: {last['from']} is there again"
    os.makedirs(os.path.dirname(last["from"]), exist_ok=True)
    os.rename(last["to"], last["from"])
    if last.get("aside") and os.path.lexists(last["aside"]):
        os.rename(last["aside"], last["to"])
    with open(MOVES, "w") as f:
        f.write("".join(l + "\n" for l in lines[:-1]))
    return f"back in downloads: {os.path.basename(last['from'])}"


# --- the TUI -----------------------------------------------------------------------------

HELP = """[b #ffc0e5]How it works[/]

  Type what you're looking for (artist and album, or a song) and press [b]Enter[/].

  Albums are on the [b]albums[/] tab, single songs on [b]tracks[/]. Both come in best first:
    [#ffd4ee]1.[/] lossless (FLAC, WAV…) before lossy (MP3…)
    [#ffd4ee]2.[/] the highest bit depth: 32, then 24, then 16
    [#ffd4ee]3.[/] the highest sample rate: 192 kHz, then 96, then 48, then 44.1
    [#ffd4ee]4.[/] the biggest, counting only the music

  [b #ffc0e5]★[/] marks the best one, already picked: [b]Enter[/] downloads it (an album: all of it).
  [b]↑ ↓[/] to pick another.

  [#b3a7cb]space  what's inside the album        b / s / f  best first / biggest / fastest
  a / t / r / d / l  albums / tracks / recent searches / downloads / library (sort what's done)
  /  search again (↑ ↓ in the box: your recent ones)      q  quit[/]
"""


def tui(first_search=None):
    os.environ.setdefault("COLORTERM", "truecolor")  # over ssh it isn't said, and it's all grey without
    from textual.app import App
    from textual.binding import Binding
    from textual.containers import Vertical
    from textual.widgets import DataTable, Footer, Input, Static, TabbedContent, TabPane

    conf = settings()
    api = Slskd(conf["url"], conf.get("api_key"))

    class Seek(App):
        TITLE = "nekozame-seek"
        ENABLE_COMMAND_PALETTE = False
        CSS = """
        Screen { background: #5a4f6e; color: #ffffff; }
        #top { height: 1; padding: 0 1; background: #433a55; }
        #title { width: auto; color: #ffc0e5; text-style: bold; }
        #status { width: 1fr; color: #e8def5; text-align: right; }
        TabbedContent { height: 1fr; }
        Tabs { background: #4f4562; }
        Tab { color: #e8def5; }
        Tab.-active { color: #ffc0e5; text-style: bold; }
        Underline > .underline--bar { color: #ffc0e5; background: #685c7f; }
        Input { background: #433a55; border: round #8a76a8; color: #ffffff; margin: 1 1 0 1; }
        Input:focus { border: round #ffc0e5; }
        Input > .input--placeholder { color: #b3a7cb; }
        #help { padding: 1 3; color: #ffffff; }
        #summary { height: 1; padding: 0 2; color: #ffd4ee; }
        DataTable { background: #4f4562; height: 1fr; margin: 0 1; scrollbar-color: #8a76a8; scrollbar-background: #433a55; }
        DataTable > .datatable--header { background: #433a55; color: #ffc0e5; text-style: bold; }
        DataTable > .datatable--cursor { background: #ffc0e5; color: #433a55; text-style: bold; }
        DataTable > .datatable--hover { background: #685c7f; }
        #libhelp { height: auto; padding: 0 2; color: #e8def5; }
        #edit { display: none; }
        #inside { height: 14; margin: 0 1; background: #433a55; border-top: solid #ffc0e5; }
        #inside > .datatable--header { background: #433a55; color: #ffc0e5; text-style: bold; }
        Footer { background: #433a55; color: #e8def5; }
        FooterKey { background: #433a55; }
        FooterKey .footer-key--key { background: #433a55; color: #ffc0e5; text-style: bold; }
        FooterKey .footer-key--description { background: #433a55; color: #e8def5; }
        """
        BINDINGS = [
            Binding("space", "inside", "what's inside"),
            Binding("b", "sort('quality')", "best first"),
            Binding("s", "sort('size')", "biggest"),
            Binding("f", "sort('speed')", "fastest"),
            Binding("slash", "focus_search", "new search"),
            Binding("a", "tab('albums')", "albums"),
            Binding("t", "tab('tracks')", "tracks"),
            Binding("r", "tab('recent')", "recent"),
            Binding("d", "tab('downloads')", "downloads"),
            Binding("l", "tab('library')", "library"),
            Binding("q", "quit", "quit"),
            Binding("ctrl+c", "quit", "quit", show=False),
        ]

        def compose(self):
            from textual.containers import Horizontal
            with Horizontal(id="top"):
                yield Static("🦈 nekozame-seek", id="title")
                yield Static("…", id="status")
            yield Input(placeholder="search Soulseek: artist and album, or a song, then Enter", id="query")
            yield Static("", id="summary")
            with TabbedContent(initial="albums"):
                with TabPane("albums", id="albums"):
                    with Vertical():
                        yield Static(HELP, id="help")
                        yield DataTable(id="results", cursor_type="row")
                        yield DataTable(id="inside", cursor_type="none", show_cursor=False)
                with TabPane("tracks", id="tracks"):
                    yield DataTable(id="songs", cursor_type="row")
                with TabPane("recent", id="recent"):
                    yield DataTable(id="history", cursor_type="row")
                with TabPane("downloads", id="downloads"):
                    yield DataTable(id="transfers", cursor_type="row")
                with TabPane("library", id="library"):
                    with Vertical():
                        yield Static("", id="libhelp")
                        yield DataTable(id="sorting", cursor_type="row")
                        yield Input(placeholder="where it goes, inside the library; Enter keeps it, Esc doesn't", id="edit")
            yield Footer()

        def on_mount(self):
            self.sort, self.found, self.singles, self.sid, self.searching = "quality", [], [], None, False
            res = self.query_one("#results", DataTable)
            res.add_columns("", "bits", "kHz", "format", "size", "tracks", "from", "can start", "album")
            res.display = False
            inside = self.query_one("#inside", DataTable)
            inside.add_columns("", "file", "bits", "kHz", "length", "size")
            inside.display = False
            self.query_one("#songs", DataTable).add_columns("", "bits", "kHz", "format", "size", "length",
                                                             "from", "can start", "track", "in")
            self.query_one("#history", DataTable).add_columns("search", "when", "results from", "files")
            self.query_one("#sorting", DataTable).add_columns("", "download", "is", "you have", "goes to")
            self.todo, self.skipped = [], set()
            self.past, self.back = [], -1
            self.load_history()
            self.query_one("#transfers", DataTable).add_columns("album", "from", "tracks", "done", "state")
            self.set_interval(1.0, self.poll)
            self.set_interval(3.0, self.poll_downloads)
            self.set_interval(30.0, self.refresh_status)
            self.refresh_status()
            if first_search:
                self.query_one("#query", Input).value = first_search
                self.start(first_search)
            else:
                self.query_one("#query", Input).focus()

        def refresh_status(self):
            self.query_one("#status", Static).update(api.status())

        def start(self, text):
            try:
                self.sid, self.found, self.singles, self.searching, self.text = api.search(text), [], [], True, text
            except (OSError, ValueError, KeyError) as e:
                self.query_one("#summary", Static).update(f"couldn't search: {e}")
                return
            self.query_one("#help", Static).display = False
            self.query_one("#inside", DataTable).display = False
            res = self.query_one("#results", DataTable)
            res.display = True
            self.show()
            (res if self.query_one(TabbedContent).active != "tracks" else self.query_one("#songs", DataTable)).focus()

        def load_history(self):
            try:
                self.past = api.searches()
            except (OSError, ValueError):
                return
            t = self.query_one("#history", DataTable)
            t.clear()
            for x in self.past:
                when = local_time(x.get("startedAt"))
                t.add_row(x.get("searchText", ""), when, f"{x.get('responseCount', 0)} users",
                          f"{x.get('fileCount', 0):,}")

        def open_past(self, x):
            """an old search, with its results as slskd kept them: no searching again"""
            self.query_one("#query", Input).value = x["searchText"]
            self.sid, self.text, self.searching = x["id"], x["searchText"], True
            self.query_one("#help", Static).display = False
            self.query_one("#inside", DataTable).display = False
            self.query_one("#results", DataTable).display = True
            self.action_tab("albums")
            self.poll()

        def on_key(self, event):
            """↑ ↓ in the search box: your recent searches. the library tab's own keys"""
            edit = self.query_one("#edit", Input)
            if edit.has_focus and event.key == "escape":
                edit.styles.display = "none"
                self.query_one("#sorting", DataTable).focus()
                event.stop()
                return
            if self.query_one("#sorting", DataTable).has_focus and event.key in ("e", "k", "x", "u", "o", "n"):
                event.stop()
                row = self.library_row()
                if event.key == "e":
                    self.action_library_edit()
                elif event.key == "k":
                    self.action_library_kind()
                elif event.key == "u":
                    self.notify(undo_last())
                    self.load_library()
                elif row is not None and event.key == "x":
                    self.skipped.add(self.todo[row]["src"])
                    self.load_library()
                elif row is not None and event.key == "o":
                    self.sort_one(row, replace=True)
                elif row is not None and event.key == "n":
                    self.sort_one(row, both=True)
                return
            box = self.query_one("#query", Input)
            if not box.has_focus or event.key not in ("up", "down") or not self.past:
                return
            texts = list(dict.fromkeys(x.get("searchText", "") for x in self.past))
            self.back = min(self.back + 1, len(texts) - 1) if event.key == "up" else max(self.back - 1, -1)
            box.value = texts[self.back] if self.back >= 0 else ""
            box.cursor_position = len(box.value)
            event.stop()

        # --- the library tab: finished downloads, where each goes, moved one at a time

        def load_library(self):
            lib, dl = conf["library"], conf["downloads"]
            help_ = self.query_one("#libhelp", Static)
            if not os.path.isdir(lib) or not os.path.isdir(dl):
                help_.update(f"the library tab sorts on the machine with the music: open nekozame-seek there "
                             f"({dl} → {lib} aren't here)")
                return
            known = {t["src"]: t for t in self.todo}
            self.todo = []
            for path in finished(dl, api):
                if path in self.skipped:
                    continue
                if path in known:  # what you changed stays
                    self.todo.append(known[path])
                    continue
                kind, artist, dest = guess(lib, path)
                self.todo.append({"src": path, "kind": kind, "artist": artist, "dest": dest})
            t = self.query_one("#sorting", DataTable)
            at = t.cursor_row
            t.clear()
            for x in self.todo:
                there = os.path.lexists(x["dest"])
                note = f"{quality_of(x['dest'])} (new: {quality_of(x['src'])})" if there else ""
                t.add_row("!" if there else "→", os.path.basename(x["src"]), KIND_NAMES[x["kind"]], note,
                          os.path.relpath(x["dest"], lib))
            if self.todo:
                t.move_cursor(row=min(at, len(self.todo) - 1))
            help_.update(
                f"[b]{len(self.todo)} finished downloads[/] to put in your library. Nothing moves until you say so; "
                "nothing is ever overwritten.\n"
                "[b #ffc0e5]Enter[/]: move it · [b #ffc0e5]e[/]: change where · "
                "[b #ffc0e5]k[/]: artist album / game / film / unsorted · [b #ffc0e5]x[/]: leave it · "
                "[b #ffc0e5]u[/]: undo the last move\n"
                "[b #ffc0e5]![/] you have it already · [b #ffc0e5]o[/]: replace it (the old one is kept aside) · "
                "[b #ffc0e5]n[/]: keep both")

        def library_row(self):
            t = self.query_one("#sorting", DataTable)
            if self.query_one(TabbedContent).active != "library" or not self.todo:
                return None
            return min(t.cursor_row, len(self.todo) - 1)

        def sort_one(self, row, replace=False, both=False):
            x = self.todo[row]
            dest = x["dest"]
            if both and os.path.lexists(dest):
                base, e = os.path.splitext(dest) if os.path.isfile(dest) else (dest, "")
                n = 2
                while os.path.lexists(f"{base} ({n}){e}"):
                    n += 1
                dest = f"{base} ({n}){e}"
            if os.path.lexists(dest) and not replace:
                self.notify("you have it already: o replaces it (the old one is kept aside), n keeps both",
                            severity="warning")
                return
            try:
                move(x["src"], dest, replace=replace)
            except (OSError, ValueError) as e:
                self.notify(f"not moved: {e}", severity="error")
                return
            self.notify(f"in your library: {os.path.relpath(dest, conf['library'])}")
            self.load_library()

        def action_library_kind(self):
            row = self.library_row()
            if row is None:
                return
            x = self.todo[row]
            order = list(KINDS)
            x["kind"] = order[(order.index(x["kind"]) + 1) % len(order)]
            x["dest"] = destination(conf["library"], x["kind"], x["artist"] or "Unknown Artist", x["src"])
            self.load_library()

        def action_library_edit(self):
            row = self.library_row()
            if row is None:
                return
            box = self.query_one("#edit", Input)
            box.value = os.path.relpath(self.todo[row]["dest"], conf["library"])
            box.styles.display = "block"
            box.focus()

        def on_input_submitted(self, event):
            if event.input.id == "edit":
                row = self.library_row()
                new = event.value.strip().strip("/")
                if row is not None and new and ".." not in new.split("/"):
                    self.todo[row]["dest"] = os.path.join(conf["library"], new)
                event.input.styles.display = "none"
                self.query_one("#sorting", DataTable).focus()
                self.load_library()
                return
            if event.value.strip():
                self.back = -1
                self.start(event.value.strip())
                self.set_timer(2.0, self.load_history)

        def on_data_table_row_selected(self, event):
            if event.data_table.id == "results" and self.found:
                self.download(self.found[event.cursor_row])
            elif event.data_table.id == "songs" and self.singles:
                self.download(self.singles[event.cursor_row])
            elif event.data_table.id == "history" and self.past:
                self.open_past(self.past[event.cursor_row])
            elif event.data_table.id == "sorting" and self.todo:
                self.sort_one(event.cursor_row)

        def poll(self):
            if not self.sid or not self.searching:
                return
            try:
                state = api.search_state(self.sid)
                got = api.responses(self.sid)
                self.found, self.singles = albums(got), tracks(got)
            except (OSError, ValueError):
                return
            self.searching = not state.get("isComplete")
            self.show(keep_cursor=True)

        def show(self, keep_cursor=False):
            res = self.query_one("#results", DataTable)
            at = res.cursor_row if keep_cursor else 0
            self.found.sort(key=SORTS[self.sort], reverse=True)
            res.clear()
            for i, a in enumerate(self.found[:400]):
                bits = str(a["depth"]) if a["lossless"] else f"{a['bitrate']}k" if a["bitrate"] else "?"
                khz = f"{a['rate'] / 1000:g}" if a["rate"] else ""
                res.add_row("★" if i == 0 and self.sort == "quality" else "", bits, khz, a["format"],
                            f"{a['mb']:,.0f} MB", str(len(a["audio"])), a["user"][:18],
                            "now" if a["free"] else f"{a['queue']} in line", title(a), key=str(i))
            if self.found:
                res.move_cursor(row=min(at, len(self.found) - 1))
            songs = self.query_one("#songs", DataTable)
            at = songs.cursor_row if keep_cursor else 0
            self.singles.sort(key=SORTS[self.sort], reverse=True)
            songs.clear()
            for i, a in enumerate(self.singles[:600]):
                bits = str(a["depth"]) if a["lossless"] else f"{a['bitrate']}k" if a["bitrate"] else "?"
                khz = f"{a['rate'] / 1000:g}" if a["rate"] else ""
                n = a["length"]
                songs.add_row("★" if i == 0 and self.sort == "quality" else "", bits, khz, a["format"],
                              f"{a['mb']:,.1f} MB", f"{n // 60}:{n % 60:02d}" if n else "", a["user"][:18],
                              "now" if a["free"] else f"{a['queue']} in line", a["name"], title(a), key=str(i))
            if self.singles:
                songs.move_cursor(row=min(at, len(self.singles) - 1))
            how = {"quality": "best first", "size": "biggest first", "speed": "fastest first"}[self.sort]
            counts = f"{len(self.found)} albums and {len(self.singles):,} tracks"
            if self.searching:
                text = f"searching for “{self.text}”… {counts} so far, {how}"
            elif self.found or self.singles:
                text = f"{counts} for “{self.text}”, {how} · Enter downloads the one picked"
            else:
                text = f"nothing found for “{self.text}”: try fewer words"
            self.query_one("#summary", Static).update(text)

        def action_inside(self):
            """the album's files, under the results; again to close"""
            inside = self.query_one("#inside", DataTable)
            inside.display = not inside.display and bool(self.found)
            self.fill_inside()

        def on_data_table_row_highlighted(self, event):
            if event.data_table.id == "results":
                self.fill_inside()

        def fill_inside(self):
            inside = self.query_one("#inside", DataTable)
            if not inside.display or not self.found:
                return
            a = self.found[min(self.query_one("#results", DataTable).cursor_row, len(self.found) - 1)]
            inside.clear()
            music = [f for f in a["files"] if f in a["audio"]]
            rest = [f for f in a["files"] if f not in a["audio"]]
            for f in sorted(music, key=lambda f: f["filename"]) + sorted(rest, key=lambda f: f["filename"]):
                name = re.split(r"[\\/]", f["filename"])[-1]
                length = f.get("length") or 0
                if f in a["audio"]:
                    bits = str(f.get("bitDepth") or "") if ext(f) in LOSSLESS else f"{f.get('bitRate') or '?'}k"
                    khz = f"{f['sampleRate'] / 1000:g}" if f.get("sampleRate") else ""
                    mark = "♪"
                else:
                    bits = khz = ""
                    mark = "·"
                inside.add_row(mark, name, bits, khz, f"{length // 60}:{length % 60:02d}" if length else "",
                               f"{f['size'] / 1e6:,.1f} MB")

        def action_sort(self, how):
            self.sort = how
            self.show()

        def action_focus_search(self):
            self.query_one("#query", Input).focus()

        def action_tab(self, tab):
            self.query_one(TabbedContent).active = tab
            table = {"albums": "#results", "tracks": "#songs", "recent": "#history", "downloads": "#transfers",
                     "library": "#sorting"}[tab]
            if tab == "library":
                self.load_library()
            if tab == "recent":
                self.load_history()
            self.query_one(table, DataTable).focus()
            if tab == "downloads":
                self.poll_downloads()

        def download(self, a):
            """an album: the whole folder (the music, its cover, the log); a track: that file"""
            try:
                api.download(a["user"], a["files"])
            except (OSError, ValueError) as e:
                self.notify(f"couldn't queue it: {e}", severity="error")
                return
            what = a.get("name") or title(a)
            self.notify(f"downloading {what}: {a['mb']:,.1f} MB, {quality(a)} {a['format']}, from {a['user']} (d shows it)")

        def poll_downloads(self):
            if self.query_one(TabbedContent).active != "downloads":
                return
            try:
                users = api.downloads()
            except (OSError, ValueError):
                return
            t = self.query_one("#transfers", DataTable)
            t.clear()
            for u in users:
                for d in u.get("directories") or []:
                    files = d.get("files") or []
                    size = sum(f.get("size") or 0 for f in files) or 1
                    done = sum(f.get("bytesTransferred") or 0 for f in files)
                    states = {(f.get("state") or "").split(",")[-1].strip() for f in files}
                    state = "done" if states <= {"Succeeded"} else ", ".join(sorted(states)).lower()
                    t.add_row(" / ".join(folder(d["directory"] + "\\x")[-2:]), u["username"],
                              str(len(files)), f"{100 * done / size:.0f}%", state)

    Seek().run()


